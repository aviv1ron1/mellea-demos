# Non-secret backend config. deploy.sh loads this into the ConfigMap
# `granite-speech-config` (envFrom on the backend Deployment).
# Copy to openshift/config.env and edit; config.env is git-ignored.

# Audio LLM — the Granite Switch model already served on the GPU cluster.
LLM_URL=https://gs-omni-audio-security.apps.dmf.dipc.res.ibm.com/v1
LLM_MODEL=granite-switch-audio
AUDIO_LLM_MAX_TOKENS=256

# Set to false only if the LLM route's TLS cert isn't trusted inside the
# container (cross-cluster edge cert). Handled in audio_llm.py.
LLM_VERIFY_SSL=true

# WebRTC ICE servers (JSON list of RTCIceServer dicts). If set, this overrides
# the built-in default (public STUN + a TURN placeholder) and the fastrtc mint.
# Required on this cluster: symmetric-NAT egress means STUN-only P2P fails, so a
# reachable TURN relay is mandatory. Point this at coturn (openshift/coturn.yaml)
# or any TURN service you have credentials for. Example:
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:<TURN_HOST>:3478"],"username":"<user>","credential":"<pass>"}]

# TTS
TTS_BACKEND=kokoro
TTS_VOICE=af_aoede
TTS_SPEED=1.25

# Persona: mounted from the `granite-speech-prompt` ConfigMap. deploy.sh builds
# that ConfigMap from the file you point PROMPT_SOURCE_FILE at (below). The
# container path here must match the mount in backend.yaml.
PROMPT_FILE=/app/prompts-custom/granite.txt

# Optional grounding documents baked into the image (docs/). Leave unset to
# disable. Set to `docs` to ground answers in the bundled .txt files.
# DOCUMENTS_DIR=docs

HOST=0.0.0.0
PORT=7860

# ---- deploy.sh-only knobs (not passed to the container) ----
# Local file whose contents become the persona ConfigMap. Write your prompt here.
PROMPT_SOURCE_FILE=prompts/granite.txt
